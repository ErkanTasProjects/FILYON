# FILYON Environment Configuration Example

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://filyon_admin:filyon_secure_pass_2026@localhost:5432/filyon_db?schema=public

# Docker Internal PostgreSQL (used when running via docker-compose)
# DATABASE_URL=postgresql://filyon_admin:filyon_secure_pass_2026@postgres:5432/filyon_db?schema=public

# JWT Authentication
JWT_SECRET=filyon_super_secret_jwt_key_2026_enterprise_fleet_management
JWT_EXPIRATION=7d

# File Storage (Local or S3/MinIO)
UPLOAD_DEST=./uploads
MAX_FILE_SIZE_MB=25

# Notification & Cron
ENABLE_REMINDER_CRON=true
CRON_SCHEDULE_DAILY="0 8 * * *"

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
